{
    "version": 2,
    "builds": [
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/index.js"
      }
    ],
    "env": {
      "MY_ENV_VAR": "value"
    },
    "functions": {
      "api/**/*.js": {
        "memory": 1024,
        "maxDuration": 10
      }
    }
  }
  